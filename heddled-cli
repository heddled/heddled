#!/usr/bin/env python3
"""Run Heddled straight from a checkout, with no install step:

    ./heddled-cli dev --port 5005
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from heddled.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
